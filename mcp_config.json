{
  "mcpServers": {
    "21st-magic": {
      "serverUrl": "https://21st.dev/api/mcp",
      "url": "https://21st.dev/api/mcp",
      "headers": {
        "x-api-key": "${TWENTY_FIRST_API_KEY}"
      }
    },
    "21st-magic-local": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@21st-dev/magic@latest"
      ],
      "env": {
        "TWENTY_FIRST_API_KEY": "${TWENTY_FIRST_API_KEY}",
        "API_KEY": "${TWENTY_FIRST_API_KEY}"
      }
    }
  }
}
