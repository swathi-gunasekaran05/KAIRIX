# LLM Provider Configuration
LLM_PROVIDER=nim

# NVIDIA NIM Configuration
NVIDIA_NIM_API_KEY=your_nvidia_nim_api_key_here
NIM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_TIMEOUT=300
NIM_MAX_RETRIES=6

# Neo4j Graph Database (AuraDB Cloud)
NEO4J_URI=neo4j+s://your_instance_id.databases.neo4j.io
NEO4J_USERNAME=your_username_or_instance_id
NEO4J_PASSWORD=your_aura_password_here
NEO4J_DATABASE=your_database_name

# Vector Database Provider (pinecone)
VECTOR_DB_PROVIDER=pinecone

# Pinecone Cloud Vector Database
PINECONE_API_KEY=pcsk_your_pinecone_api_key_here
PINECONE_INDEX_NAME=kairix

# Embedding Model & Hugging Face Hub Authentication
EMBEDDING_MODEL=all-MiniLM-L6-v2
HF_TOKEN=your_huggingface_token_here
